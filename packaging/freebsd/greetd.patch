@@ -0,0 +1,49 @@
+use nix::{ioctl_none, ioctl_read, ioctl_write_int, ioctl_write_ptr};
+
+pub const KDTEXT: i32 = 0x00;
+pub const KDGRAPHICS: i32 = 0x01;
+const KD_MODE_MAGIC: u8 = b'K';
+const KD_SETMODE: u8 = 10;
+
+const VT_IOCTL_MAGIC: u8 = b'v';
+const VT_OPENQRY: u8 = 1;
+const VT_SETMODE: u8 = 2;
+const VT_ACTIVATE: u8 = 5;
+const VT_GETACTIVE: u8 = 7;
+const VT_WAITACTIVATE: u8 = 6;
+pub const VT_AUTO: u8 = 0;
+const TIOC_IOCTL_MAGIC: u8 = b't';
+const TIOCSCTTY: u8 = 97;
+
+ioctl_write_int!(kd_setmode, KD_MODE_MAGIC, KD_SETMODE);
+ioctl_write_int!(_vt_activate, VT_IOCTL_MAGIC, VT_ACTIVATE);
+ioctl_write_int!(_vt_waitactive, VT_IOCTL_MAGIC, VT_WAITACTIVATE);
+ioctl_write_ptr!(vt_setmode, VT_IOCTL_MAGIC, VT_SETMODE, vt_mode);
+ioctl_read!(vt_getactive, VT_IOCTL_MAGIC, VT_GETACTIVE, i32);
+ioctl_read!(vt_openqry, VT_IOCTL_MAGIC, VT_OPENQRY, i32);
+ioctl_none!(_term_tiocsctty, TIOC_IOCTL_MAGIC, TIOCSCTTY);
+
+// FreeBSD internally counts ttyvN as N+1 so we need some helper functions for
+// the ioctls.
+pub unsafe fn vt_activate(fd: i32, vt: i32) -> nix::Result<i32> {
+    _vt_activate(fd, vt.checked_add(1).ok_or(nix::errno::Errno::EINVAL)?)
+}
+
+pub unsafe fn vt_waitactive(fd: i32, vt: i32) -> nix::Result<i32> {
+    _vt_waitactive(fd, vt.checked_add(1).ok_or(nix::errno::Errno::EINVAL)?)
+}
+
+// TIOCSCTTY does not require an argument on FreeBSD.
+pub unsafe fn term_tiocsctty(fd: i32, _: i32) -> nix::Result<i32> {
+    _term_tiocsctty(fd)
+}
+
+#[allow(dead_code)]
+#[repr(C)]
+pub struct vt_mode {
+    pub mode: u8,
+    pub waitv: u8,
+    pub relsig: u16,
+    pub acqsig: u16,
+    pub frsig: u16,
+}
