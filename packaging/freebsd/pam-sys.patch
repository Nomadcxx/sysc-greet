@@ -0,0 +1,91 @@
+extern crate pam_sys;
+
+#[cfg(target_os = "freebsd")]
+#[test]
+fn constants_match_system_headers() {
+    use std::{env, fs, io::Write, os::unix::fs::DirBuilderExt, process::{Command, Stdio}};
+    use pam_sys::{PamFlag, PamItemType, PamMessageStyle, PamReturnCode};
+    let values = [
+        ("PAM_SUCCESS", PamReturnCode::SUCCESS as i32),
+        ("PAM_OPEN_ERR", PamReturnCode::OPEN_ERR as i32),
+        ("PAM_SYMBOL_ERR", PamReturnCode::SYMBOL_ERR as i32),
+        ("PAM_SERVICE_ERR", PamReturnCode::SERVICE_ERR as i32),
+        ("PAM_SYSTEM_ERR", PamReturnCode::SYSTEM_ERR as i32),
+        ("PAM_BUF_ERR", PamReturnCode::BUF_ERR as i32),
+        ("PAM_CONV_ERR", PamReturnCode::CONV_ERR as i32),
+        ("PAM_PERM_DENIED", PamReturnCode::PERM_DENIED as i32),
+        ("PAM_MAXTRIES", PamReturnCode::MAXTRIES as i32),
+        ("PAM_AUTH_ERR", PamReturnCode::AUTH_ERR as i32),
+        ("PAM_NEW_AUTHTOK_REQD", PamReturnCode::NEW_AUTHTOK_REQD as i32),
+        ("PAM_CRED_INSUFFICIENT", PamReturnCode::CRED_INSUFFICIENT as i32),
+        ("PAM_AUTHINFO_UNAVAIL", PamReturnCode::AUTHINFO_UNAVAIL as i32),
+        ("PAM_USER_UNKNOWN", PamReturnCode::USER_UNKNOWN as i32),
+        ("PAM_CRED_UNAVAIL", PamReturnCode::CRED_UNAVAIL as i32),
+        ("PAM_CRED_EXPIRED", PamReturnCode::CRED_EXPIRED as i32),
+        ("PAM_CRED_ERR", PamReturnCode::CRED_ERR as i32),
+        ("PAM_ACCT_EXPIRED", PamReturnCode::ACCT_EXPIRED as i32),
+        ("PAM_AUTHTOK_EXPIRED", PamReturnCode::AUTHTOK_EXPIRED as i32),
+        ("PAM_SESSION_ERR", PamReturnCode::SESSION_ERR as i32),
+        ("PAM_AUTHTOK_ERR", PamReturnCode::AUTHTOK_ERR as i32),
+        ("PAM_AUTHTOK_RECOVERY_ERR", PamReturnCode::AUTHTOK_RECOVERY_ERR as i32),
+        ("PAM_AUTHTOK_LOCK_BUSY", PamReturnCode::AUTHTOK_LOCK_BUSY as i32),
+        ("PAM_AUTHTOK_DISABLE_AGING", PamReturnCode::AUTHTOK_DISABLE_AGING as i32),
+        ("PAM_NO_MODULE_DATA", PamReturnCode::NO_MODULE_DATA as i32),
+        ("PAM_IGNORE", PamReturnCode::IGNORE as i32),
+        ("PAM_ABORT", PamReturnCode::ABORT as i32),
+        ("PAM_TRY_AGAIN", PamReturnCode::TRY_AGAIN as i32),
+        ("PAM_MODULE_UNKNOWN", PamReturnCode::MODULE_UNKNOWN as i32),
+        ("PAM_DOMAIN_UNKNOWN", PamReturnCode::DOMAIN_UNKNOWN as i32),
+        ("PAM_BAD_HANDLE", PamReturnCode::BAD_HANDLE as i32),
+        ("PAM_BAD_ITEM", PamReturnCode::BAD_ITEM as i32),
+        ("PAM_BAD_FEATURE", PamReturnCode::BAD_FEATURE as i32),
+        ("PAM_BAD_CONSTANT", PamReturnCode::BAD_CONSTANT as i32),
+        ("PAM_SILENT", PamFlag::SILENT as i32),
+        ("PAM_DISALLOW_NULL_AUTHTOK", PamFlag::DISALLOW_NULL_AUTHTOK as i32),
+        ("PAM_ESTABLISH_CRED", PamFlag::ESTABLISH_CRED as i32),
+        ("PAM_DELETE_CRED", PamFlag::DELETE_CRED as i32),
+        ("PAM_REINITIALIZE_CRED", PamFlag::REINITIALIZE_CRED as i32),
+        ("PAM_REFRESH_CRED", PamFlag::REFRESH_CRED as i32),
+        ("PAM_CHANGE_EXPIRED_AUTHTOK", PamFlag::CHANGE_EXPIRED_AUTHTOK as i32),
+        ("PAM_SERVICE", PamItemType::SERVICE as i32),
+        ("PAM_USER", PamItemType::USER as i32),
+        ("PAM_TTY", PamItemType::TTY as i32),
+        ("PAM_RHOST", PamItemType::RHOST as i32),
+        ("PAM_CONV", PamItemType::CONV as i32),
+        ("PAM_AUTHTOK", PamItemType::AUTHTOK as i32),
+        ("PAM_OLDAUTHTOK", PamItemType::OLDAUTHTOK as i32),
+        ("PAM_RUSER", PamItemType::RUSER as i32),
+        ("PAM_USER_PROMPT", PamItemType::USER_PROMPT as i32),
+        ("PAM_REPOSITORY", PamItemType::REPOSITORY as i32),
+        ("PAM_AUTHTOK_PROMPT", PamItemType::AUTHTOK_PROMPT as i32),
+        ("PAM_OLDAUTHTOK_PROMPT", PamItemType::OLDAUTHTOK_PROMPT as i32),
+        ("PAM_HOST", PamItemType::HOST as i32),
+        ("PAM_PROMPT_ECHO_OFF", PamMessageStyle::PROMPT_ECHO_OFF as i32),
+        ("PAM_PROMPT_ECHO_ON", PamMessageStyle::PROMPT_ECHO_ON as i32),
+        ("PAM_ERROR_MSG", PamMessageStyle::ERROR_MSG as i32),
+        ("PAM_TEXT_INFO", PamMessageStyle::TEXT_INFO as i32),
+    ];
+    let dir = env::temp_dir().join(format!("pam-abi-{}", std::process::id()));
+    fs::DirBuilder::new().mode(0o700).create(&dir).unwrap();
+    let probe = dir.join("probe");
+    let mut code = String::from("#include <security/pam_appl.h>\n#include <stdio.h>\nint main(void) {\n");
+    for &(name, _) in &values {
+        code.push_str(&format!("printf(\"%d\\n\", (int){});\n", name));
+    }
+    code.push_str("return 0; }\n");
+    let mut cc = Command::new("cc").args(&["-x", "c", "-o"]).arg(&probe).arg("-")
+        .stdin(Stdio::piped()).spawn().unwrap();
+    cc.stdin.take().unwrap().write_all(code.as_bytes()).unwrap();
+    assert!(cc.wait().unwrap().success());
+    let output = Command::new(&probe).output().unwrap();
+    fs::remove_dir_all(&dir).unwrap();
+    assert!(output.status.success());
+    let native: Vec<i32> = String::from_utf8(output.stdout).unwrap().lines().map(|s| s.parse().unwrap()).collect();
+    assert_eq!(native.len(), values.len());
+    for (i, &(name, rust)) in values.iter().enumerate() {
+        assert_eq!(rust, native[i], "{} differs from the installed OpenPAM ABI", name);
+        if i < 34 {
+            assert_eq!(PamReturnCode::from(native[i]) as i32, native[i]);
+        }
+    }
+}
