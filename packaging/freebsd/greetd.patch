+#[cfg(test)]
+mod tests {
+    use super::{tty_number, tty_path};
+
+    #[cfg(target_os = "freebsd")]
+    #[test]
+    #[ignore = "requires access to native FreeBSD virtual consoles"]
+    fn native_console_queries() {
+        let terminal = super::Terminal::open(&tty_path(0)).unwrap();
+        let current = terminal.vt_get_current().unwrap();
+        let next = terminal.vt_get_next().unwrap();
+        assert!(current < 16);
+        assert!(next < 16);
+        assert!(std::path::Path::new(&tty_path(current)).exists());
+        assert!(std::path::Path::new(&tty_path(next)).exists());
+        let mut kernel_current: i32 = 0;
+        unsafe { super::ioctl::vt_getactive(terminal.fd, &mut kernel_current) }.unwrap();
+        assert_eq!(current + 1, kernel_current as usize);
+    }
+
+    #[test]
+    fn console_paths_round_trip() {
+        for vt in [0, 1, 7, 10, 15] {
+            assert_eq!(tty_number(&tty_path(vt)), Some(vt));
+        }
+        assert_eq!(tty_number("/dev/pts/1"), None);
+        assert_eq!(tty_number("/dev/tty"), None);
+        assert_eq!(tty_number("/dev/ttyv"), None);
+        #[cfg(target_os = "freebsd")]
+        assert_eq!(tty_path(10), "/dev/ttyva");
+        #[cfg(target_os = "linux")]
+        assert_eq!(tty_path(10), "/dev/tty10");
+    }
+}
