+#[cfg(target_os = "freebsd")]
+const TTY_PREFIX: &str = "/dev/ttyv";
+#[cfg(not(target_os = "freebsd"))]
+const TTY_PREFIX: &str = "/dev/tty";
+
+pub fn tty_path(vt: usize) -> String {
+    if cfg!(target_os = "freebsd") {
+        format!("{TTY_PREFIX}{vt:x}")
+    } else {
+        format!("{TTY_PREFIX}{vt}")
+    }
+}
+
+pub fn tty_number(path: &str) -> Option<usize> {
+    let radix = if cfg!(target_os = "freebsd") { 16 } else { 10 };
+    usize::from_str_radix(path.strip_prefix(TTY_PREFIX)?, radix).ok()
+}
